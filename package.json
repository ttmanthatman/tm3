{
  "name": "tm3",
  "version": "0.12.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node --max-old-space-size=${BUILD_NODE_MAX_OLD_SPACE_SIZE:-768} ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "migrate:sqlite": "node dist/server/scripts/migrate-sqlite.js",
    "migrate:sqlite:src": "tsx src/scripts/migrate-sqlite.ts",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:public-tree": "tsx src/scripts/check-public-tree.ts",
    "check:quick": "npm run check:public-tree && npm run check",
    "test:ui-logic": "tsx src/scripts/run-ui-logic-tests.ts",
    "test:security": "node --import tsx --test src/server/*.test.ts src/scripts/service-worker.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-vue-next": "^0.468.0",
    "marked": "^14.1.4",
    "matter-js": "^0.20.0",
    "pinia": "^3.0.3",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.16",
    "web-push": "^3.6.7",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.15.32",
    "@types/sanitize-html": "^2.16.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^10.0.3",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=22"
  }
}
