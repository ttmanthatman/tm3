# Operator-selected public repository and fixed branch. No device credentials.
RELAY_UPDATE_REPOSITORY=https://github.com/example/team-chat.git
RELAY_UPDATE_BRANCH=main
RELAY_UPDATE_SERVICE=wechat-relay.service
# Optional; defaults to the updater's Node executable.
# RELAY_UPDATE_NODE=/usr/local/bin/node
# RELAY_UPDATE_START_TIMEOUT_MS=30000
