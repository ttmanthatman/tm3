# The server and this device share one private agent token. Source channel,
# target group, binding, tests, and enablement are managed in the chat admin UI.
RELAY_BASE_URL=https://chat.example.com
RELAY_AGENT_TOKEN=replace-with-the-server-agent-token
# Optional. Leave empty unless the deployment has a supported message deep-link format.
RELAY_MESSAGE_URL_TEMPLATE=

RELAY_DATABASE_PATH=/var/lib/wechat-relay/relay.sqlite
RELAY_DRIVER=x11
RELAY_POLL_INTERVAL_MS=30000
RELAY_MIN_SEND_INTERVAL_MS=5000
RELAY_RETRY_BASE_MS=30000
RELAY_MAX_ATTEMPTS=5
RELAY_MAX_MESSAGE_AGE_MS=43200000

# The VM desktop must use X11 at a fixed 1280x720 resolution.
DISPLAY=:0
RELAY_X11_WINDOW_CLASS=wechat
RELAY_X11_WINDOW_TITLE=微信
RELAY_X11_WINDOW_WIDTH=1280
RELAY_X11_WINDOW_HEIGHT=720
RELAY_X11_ANCHOR_PATH=/var/lib/wechat-relay/target-anchor.png
RELAY_X11_ANCHOR_REGION=420,20,440,70
RELAY_X11_INPUT_POINT=820,650
RELAY_X11_MESSAGE_REGION=330,100,900,470
RELAY_X11_ANCHOR_MAX_DIFFERENCE=0.06
RELAY_X11_MESSAGE_MIN_DIFFERENCE=0.01
