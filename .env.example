NODE_ENV="production"
DATABASE_URL="mysql://team_chat:change-me@127.0.0.1:3306/team_chat"
JWT_SECRET="replace-with-at-least-32-random-characters"
ENGINE_API_TOKEN="change-me"
AI_SETTINGS_SECRET="change-this-ai-settings-encryption-secret"
DEFAULT_ADMIN_PASSWORD="change-this-admin-password"
VAPID_SUBJECT="mailto:admin@example.com"
# Optional: leave blank to auto-generate and persist in the settings table.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
PORT=3003
STORAGE_ROOT="./storage"
CORS_ORIGINS="https://chat.example.com"
# Default trusts only a reverse proxy on this host. Set true only behind a fully trusted proxy network.
TRUST_PROXY="false"
APP_RELEASE_DEVELOPER="Team Chat"
UPDATE_REPO_URL="https://github.com/ttmanthatman/tm3.git"
UPDATE_BRANCH="main"
UPDATE_RESTART_MODE="pm2"
UPDATE_PM2_APP="team-chat"
# UPDATE_RESTART_COMMAND="sudo systemctl restart team-chat.service"
LEGACY_SQLITE="./legacy/database.sqlite"
LEGACY_ROOT="./legacy"
