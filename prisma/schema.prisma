generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ActorKind {
  human
  virtual
  system
}

enum AccountRole {
  user
  admin
}

enum ChannelRole {
  owner
  admin
  member
  viewer
}

enum ChannelKind {
  standard
  direct
  reception
  why
  aiLounge
  music
}

enum DeviceKind {
  desktop
  mobile
  tablet
}

enum MessageType {
  text
  image
  file
  music_playlist
  chain
  prayer
  sermon_request
  why_topic_card
  bible_session
  system
}

enum PinnedKind {
  notice
  message
}

enum EngineEventKind {
  message_created
  idle_tick
  manual_test
  active_topic_due
}

enum WhyTopicStatus {
  active
  completed
  deleted
}

enum WhyTopicMemberRole {
  owner
  member
  requested
}

enum WhyAssistantRunStatus {
  pending
  running
  success
  failed
}

model Account {
  id                      Int                             @id @default(autoincrement())
  username                String                          @unique @db.VarChar(64)
  passwordHash            String                          @map("password_hash") @db.VarChar(255)
  displayName             String                          @map("display_name") @db.VarChar(80)
  avatarPath              String?                         @map("avatar_path") @db.VarChar(255)
  role                    AccountRole                     @default(user)
  isGuest                 Boolean                         @default(false) @map("is_guest")
  guestExpiresAt          DateTime?                       @map("guest_expires_at")
  theme                   String                          @default("wechat") @db.VarChar(32)
  biblePreferences        Json?                           @map("bible_preferences")
  canPinMessages          Boolean                         @default(false) @map("can_pin_messages")
  sermonPresenterUntil    DateTime?                       @map("sermon_presenter_until")
  lastLoginAt             DateTime?                       @map("last_login_at")
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  actor                   Actor?
  memberships             ChannelMember[]
  notificationPreferences ChannelNotificationPreference[]
  channelReads            ChannelRead[]
  pushSubs                PushSubscription[]
  voiceListens            VoiceListen[]
  audits                  AuditLog[]
  sessions                AccountSession[]
  prayerActions           PrayerAction[]
  aiSuggestions           MessageAiSuggestion[]
  pinnedSeens             PinnedSeen[]
  messageLikes            MessageLike[]
  messageFavorites        MessageFavorite[]
  bibleFavorites          BibleFavorite[]
  musicFavorites          MusicFavorite[]
  musicPlays              MusicPlay[]
  musicPlaylists          MusicPlaylist[]
  musicPlaybackState      MusicPlaybackState?
  friendPlaybacks         FriendPlayback[]
  whyReads                WhyTopicRead[]

  @@map("accounts")
}

model AccountSession {
  id         String     @id @db.VarChar(64)
  accountId  Int        @map("account_id")
  deviceKind DeviceKind @map("device_kind")
  deviceName String     @map("device_name") @db.VarChar(120)
  userAgent  String?    @map("user_agent") @db.Text
  ipAddress  String?    @map("ip_address") @db.VarChar(64)
  createdAt  DateTime   @default(now()) @map("created_at")
  lastSeenAt DateTime   @default(now()) @map("last_seen_at")
  expiresAt  DateTime   @map("expires_at")
  revokedAt  DateTime?  @map("revoked_at")
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, deviceKind, revokedAt])
  @@index([expiresAt])
  @@map("account_sessions")
}

model AccountLoginLog {
  id         Int      @id @default(autoincrement())
  kind       String   @db.VarChar(32)
  accountId  Int      @map("account_id")
  sessionId  String?  @map("session_id") @db.VarChar(64)
  deviceKind String?  @map("device_kind") @db.VarChar(16)
  deviceName String?  @map("device_name") @db.VarChar(120)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "account_login_logs_created_at_idx")
  @@index([accountId], map: "account_login_logs_account_id_idx")
  @@map("account_login_logs")
}

model AccountActivityLog {
  id              Int      @id @default(autoincrement())
  kind            String   @db.VarChar(48)
  accountId       Int      @map("account_id")
  sessionId       String?  @map("session_id") @db.VarChar(64)
  channelId       Int?     @map("channel_id")
  trackId         Int?     @map("track_id")
  playbackId      String?  @map("playback_id") @db.Char(36)
  deviceKind      String?  @map("device_kind") @db.VarChar(16)
  deviceName      String?  @map("device_name") @db.VarChar(120)
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.Text
  appVersion      String?  @map("app_version") @db.VarChar(32)
  latestVersion   String?  @map("latest_version") @db.VarChar(32)
  isLatestVersion Boolean? @map("is_latest_version")
  eventState      String?  @map("event_state") @db.VarChar(32)
  progressMs      Int?     @map("progress_ms")
  listenedMs      Int?     @map("listened_ms")
  durationMs      Int?     @map("duration_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "account_activity_logs_created_at_idx")
  @@index([accountId, createdAt], map: "account_activity_logs_account_created_idx")
  @@index([kind, createdAt], map: "account_activity_logs_kind_created_idx")
  @@index([trackId, createdAt], map: "account_activity_logs_track_created_idx")
  @@index([playbackId, createdAt], map: "account_activity_logs_playback_created_idx")
  @@map("account_activity_logs")
}

model Actor {
  id          Int               @id @default(autoincrement())
  kind        ActorKind
  accountId   Int?              @unique @map("account_id")
  username    String            @unique @db.VarChar(80)
  displayName String            @map("display_name") @db.VarChar(80)
  avatarPath  String?           @map("avatar_path") @db.VarChar(255)
  status      String            @default("active") @db.VarChar(32)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  account     Account?          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages    Message[]
  character   VirtualCharacter?

  @@index([kind])
  @@map("actors")
}

model Channel {
  id                      Int                             @id @default(autoincrement())
  kind                    ChannelKind                     @default(standard)
  name                    String                          @db.VarChar(80)
  description             String                          @default("") @db.VarChar(255)
  icon                    String                          @default("#") @db.VarChar(16)
  listColor               String?                         @map("list_color") @db.Char(7)
  isPrivate               Boolean                         @default(false) @map("is_private")
  isDefault               Boolean                         @default(false) @map("is_default")
  directKey               String?                         @unique @map("direct_key") @db.VarChar(120)
  receptionOwnerAccountId Int?                            @map("reception_owner_account_id")
  receptionTokenHash      String?                         @unique @map("reception_token_hash") @db.Char(64)
  receptionExpiresAt      DateTime?                       @map("reception_expires_at")
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  members                 ChannelMember[]
  notificationPreferences ChannelNotificationPreference[]
  reads                   ChannelRead[]
  messages                Message[]
  pinned                  PinnedItem[]

  @@map("channels")
}

model ChannelMember {
  id        Int         @id @default(autoincrement())
  channelId Int         @map("channel_id")
  accountId Int         @map("account_id")
  role      ChannelRole @default(member)
  createdAt DateTime    @default(now()) @map("created_at")
  channel   Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([channelId, accountId])
  @@map("channel_members")
}

model ChannelNotificationPreference {
  id        Int      @id @default(autoincrement())
  channelId Int      @map("channel_id")
  accountId Int      @map("account_id")
  muted     Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([channelId, accountId])
  @@index([accountId, muted])
  @@map("channel_notification_preferences")
}

model ChannelRead {
  id                Int      @id @default(autoincrement())
  channelId         Int      @map("channel_id")
  accountId         Int      @map("account_id")
  lastReadMessageId Int      @default(0) @map("last_read_message_id")
  updatedAt         DateTime @updatedAt @map("updated_at")
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([channelId, accountId])
  @@index([accountId, updatedAt])
  @@map("channel_reads")
}

model Message {
  id              Int                   @id @default(autoincrement())
  channelId       Int                   @map("channel_id")
  senderActorId   Int                   @map("sender_actor_id")
  content         String?               @db.Text
  type            MessageType           @default(text)
  payload         Json?
  fileName        String?               @map("file_name") @db.VarChar(255)
  filePath        String?               @map("file_path") @db.VarChar(255)
  fileSize        Int?                  @map("file_size")
  replyToId       Int?                  @map("reply_to_id")
  chainRootId     Int?                  @map("chain_root_id")
  chainVersion    Int?                  @map("chain_version")
  musicOrder      Int?                  @map("music_order")
  createdAt       DateTime              @default(now()) @map("created_at")
  channel         Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          Actor                 @relation(fields: [senderActorId], references: [id])
  replyTo         Message?              @relation("message_replies", fields: [replyToId], references: [id])
  replies         Message[]             @relation("message_replies")
  voiceListens    VoiceListen[]
  prayerActions   PrayerAction[]
  aiSuggestions   MessageAiSuggestion[]
  whyReads        WhyTopicRead[]
  likes           MessageLike[]
  favorites       MessageFavorite[]
  musicScores     MusicScore[]
  musicLyrics     MusicLyrics?
  musicPlays      MusicPlay[]
  musicFavorites  MusicFavorite[]
  playlistTracks  MusicPlaylistTrack[]
  playlistShares  MusicPlaylistShare[]
  musicPlaybackStates MusicPlaybackState[]

  @@index([channelId, id])
  @@index([replyToId])
  @@index([chainRootId])
  @@map("messages")
}

model MusicScore {
  id                  Int              @id @default(autoincrement())
  trackId             Int?             @map("track_id")
  title               String           @db.VarChar(255)
  uploadedByAccountId Int?             @map("uploaded_by_account_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  track               Message?         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  pages               MusicScorePage[]

  @@index([trackId])
  @@map("music_scores")
}

model MusicScorePage {
  id        Int         @id @default(autoincrement())
  scoreId   Int         @map("score_id")
  pageIndex Int         @map("page_index")
  fileName  String      @map("file_name") @db.VarChar(255)
  filePath  String      @unique @map("file_path") @db.VarChar(255)
  fileSize  Int         @map("file_size")
  width     Int
  height    Int
  createdAt DateTime    @default(now()) @map("created_at")
  score     MusicScore  @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@unique([scoreId, pageIndex])
  @@index([scoreId])
  @@map("music_score_pages")
}

model MusicLyrics {
  id                  Int      @id @default(autoincrement())
  trackId             Int?     @unique @map("track_id")
  fileName            String   @map("file_name") @db.VarChar(255)
  content             String   @db.LongText
  uploadedByAccountId Int?     @map("uploaded_by_account_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  track               Message? @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("music_lyrics")
}

model MusicPlay {
  id          Int      @id @default(autoincrement())
  trackId     Int      @map("track_id")
  accountId   Int      @map("account_id")
  playbackId  String   @unique @map("playback_id") @db.Char(36)
  durationMs  Int      @map("duration_ms")
  listenedMs  Int      @map("listened_ms")
  qualifiedAt DateTime @default(now()) @map("qualified_at")
  track       Message  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([trackId, qualifiedAt])
  @@index([accountId, qualifiedAt])
  @@map("music_plays")
}

model MusicFavorite {
  id        Int      @id @default(autoincrement())
  trackId   Int      @map("track_id")
  accountId Int      @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")
  track     Message  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([trackId, accountId])
  @@index([accountId, createdAt])
  @@map("music_favorites")
}

model MusicPlaylist {
  id         Int                  @id @default(autoincrement())
  accountId  Int                  @map("account_id")
  name       String               @db.VarChar(120)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  account    Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tracks     MusicPlaylistTrack[]
  shares     MusicPlaylistShare[]
  playStates MusicPlaybackState[]

  @@index([accountId, updatedAt])
  @@map("music_playlists")
}

model MusicPlaylistTrack {
  id         Int           @id @default(autoincrement())
  playlistId Int           @map("playlist_id")
  trackId    Int           @map("track_id")
  position   Int
  createdAt  DateTime      @default(now()) @map("created_at")
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Message       @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@unique([playlistId, position])
  @@index([trackId])
  @@map("music_playlist_tracks")
}

model MusicPlaylistShare {
  id         Int           @id @default(autoincrement())
  playlistId Int           @map("playlist_id")
  messageId  Int           @unique @map("message_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  message    Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([playlistId])
  @@map("music_playlist_shares")
}

model MusicPlaybackState {
  accountId    Int            @id @map("account_id")
  sourceKind   String         @default("library") @map("source_kind") @db.VarChar(16)
  playlistId   Int?           @map("playlist_id")
  trackId      Int?           @map("track_id")
  progressMs   Int            @default(0) @map("progress_ms")
  playbackMode String         @default("shuffle") @map("playback_mode") @db.VarChar(16)
  updatedAt    DateTime       @updatedAt @map("updated_at")
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  playlist     MusicPlaylist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  track        Message?       @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([playlistId])
  @@index([trackId])
  @@map("music_playback_states")
}

model FriendPlayback {
  accountId   Int      @map("account_id")
  programId   String   @map("program_id") @db.VarChar(32)
  seriesTitle String   @map("series_title") @db.VarChar(190)
  title       String   @db.VarChar(255)
  audioUrl    String   @map("audio_url") @db.VarChar(512)
  imageUrl    String?  @map("image_url") @db.VarChar(512)
  progressMs  Int      @default(0) @map("progress_ms")
  durationMs  Int      @default(0) @map("duration_ms")
  playedAt    DateTime @updatedAt @map("played_at")
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, programId])
  @@index([accountId, playedAt])
  @@map("friend_playbacks")
}

model MessageLike {
  id          Int       @id @default(autoincrement())
  messageId   Int       @map("message_id")
  accountId   Int       @map("account_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  dismissedAt DateTime? @map("dismissed_at")
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([messageId, accountId])
  @@index([accountId, createdAt])
  @@index([dismissedAt, createdAt])
  @@map("message_likes")
}

model MessageFavorite {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  accountId Int      @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([messageId, accountId])
  @@index([accountId, createdAt])
  @@map("message_favorites")
}

model BibleFavorite {
  id        Int      @id @default(autoincrement())
  accountId Int      @map("account_id")
  bookCode  String   @map("book_code") @db.Char(3)
  chapter   Int
  verse     Int
  color     String   @default("#f28b82") @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, bookCode, chapter, verse])
  @@index([accountId, createdAt])
  @@map("bible_favorites")
}

model WhyTopic {
  id               Int               @id @default(autoincrement())
  ownerAccountId   Int               @map("owner_account_id")
  channelId        Int               @unique @map("channel_id")
  sourceChannelId  Int?              @map("source_channel_id")
  sourceMessageId  Int?              @map("source_message_id")
  cardMessageId    Int?              @unique @map("card_message_id")
  title            String            @db.VarChar(160)
  summary          String            @db.Text
  originalQuestion String            @map("original_question") @db.Text
  completionNote   String?           @map("completion_note") @db.Text
  status           WhyTopicStatus    @default(active)
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  members          WhyTopicMember[]
  assistantRuns    WhyAssistantRun[]
  reads            WhyTopicRead[]

  @@index([ownerAccountId, status, updatedAt])
  @@index([sourceChannelId, createdAt])
  @@map("why_topics")
}

model WhyTopicMember {
  id        Int                @id @default(autoincrement())
  topicId   Int                @map("topic_id")
  accountId Int                @map("account_id")
  role      WhyTopicMemberRole @default(member)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  topic     WhyTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, accountId])
  @@index([accountId, role])
  @@map("why_topic_members")
}

model WhyAssistantRun {
  id               Int                   @id @default(autoincrement())
  topicId          Int                   @map("topic_id")
  triggerMessageId Int?                  @map("trigger_message_id")
  status           WhyAssistantRunStatus @default(pending)
  promptText       String                @map("prompt_text") @db.Text
  contextText      String                @map("context_text") @db.Text
  responseText     String?               @map("response_text") @db.Text
  sources          Json?
  errorText        String?               @map("error_text") @db.Text
  model            String?               @db.VarChar(120)
  baseUrl          String?               @map("base_url") @db.VarChar(255)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  topic            WhyTopic              @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, status, createdAt])
  @@map("why_assistant_runs")
}

model WhyTopicRead {
  id                Int      @id @default(autoincrement())
  topicId           Int      @map("topic_id")
  accountId         Int      @map("account_id")
  lastReadMessageId Int?     @map("last_read_message_id")
  readAt            DateTime @default(now()) @map("read_at")
  topic             WhyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  message           Message? @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([topicId, accountId])
  @@index([accountId, readAt])
  @@map("why_topic_reads")
}

model VoiceListen {
  id         Int      @id @default(autoincrement())
  messageId  Int      @map("message_id")
  accountId  Int      @map("account_id")
  listenedAt DateTime @default(now()) @map("listened_at")
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([messageId, accountId])
  @@index([accountId, listenedAt])
  @@map("voice_listens")
}

model PrayerAction {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  accountId Int      @map("account_id")
  prayedAt  DateTime @default(now()) @map("prayed_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([messageId, prayedAt])
  @@index([accountId, prayedAt])
  @@map("prayer_actions")
}

model MessageAiSuggestion {
  id                 Int      @id @default(autoincrement())
  messageId          Int      @map("message_id")
  kind               String   @default("prayer_related_verses") @db.VarChar(64)
  status             String   @default("success") @db.VarChar(24)
  promptCommand      String   @map("prompt_command") @db.Text
  contextText        String   @map("context_text") @db.Text
  responseText       String?  @map("response_text") @db.Text
  references         Json?
  errorText          String?  @map("error_text") @db.Text
  model              String?  @db.VarChar(120)
  baseUrl            String?  @map("base_url") @db.VarChar(255)
  createdByAccountId Int?     @map("created_by_account_id")
  createdAt          DateTime @default(now()) @map("created_at")
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy          Account? @relation(fields: [createdByAccountId], references: [id], onDelete: SetNull)

  @@index([messageId, kind, status, createdAt])
  @@index([createdByAccountId, createdAt])
  @@map("message_ai_suggestions")
}

model Setting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model PinnedItem {
  id        Int          @id @default(autoincrement())
  channelId Int          @map("channel_id")
  kind      PinnedKind
  title     String?      @db.VarChar(160)
  content   String?      @db.Text
  body      Json?
  messageId Int?         @map("message_id")
  version   Int          @default(1)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  seens     PinnedSeen[]

  @@index([channelId, active])
  @@map("pinned_items")
}

model PinnedSeen {
  id            Int        @id @default(autoincrement())
  accountId     Int        @map("account_id")
  channelId     Int        @map("channel_id")
  pinnedItemId  Int        @map("pinned_item_id")
  pinnedVersion Int        @map("pinned_version")
  seenAt        DateTime   @default(now()) @map("seen_at")
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pinnedItem    PinnedItem @relation(fields: [pinnedItemId], references: [id], onDelete: Cascade)

  @@unique([accountId, pinnedItemId, pinnedVersion])
  @@index([accountId, channelId])
  @@map("pinned_seens")
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  accountId  Int      @map("account_id")
  endpoint   String   @unique @db.VarChar(512)
  origin     String   @default("") @db.VarChar(255)
  keysP256dh String   @map("keys_p256dh") @db.VarChar(255)
  keysAuth   String   @map("keys_auth") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, origin])
  @@map("push_subscriptions")
}

model VirtualCharacter {
  id            Int               @id @default(autoincrement())
  actorId       Int               @unique @map("actor_id")
  enabled       Boolean           @default(true)
  config        Json
  state         Json?
  engineBinding Json?             @map("engine_binding")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  actor         Actor             @relation(fields: [actorId], references: [id], onDelete: Cascade)
  memories      CharacterMemory[]

  @@map("virtual_characters")
}

model CharacterMemory {
  id          Int              @id @default(autoincrement())
  characterId Int              @map("character_id")
  subjectType String           @map("subject_type") @db.VarChar(32)
  subjectId   String           @map("subject_id") @db.VarChar(80)
  content     String           @db.Text
  confidence  Float            @default(1)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  character   VirtualCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, subjectType, subjectId])
  @@map("character_memories")
}

model EngineEvent {
  id          Int             @id @default(autoincrement())
  kind        EngineEventKind
  channelId   Int?            @map("channel_id")
  messageId   Int?            @map("message_id")
  characterId Int?            @map("character_id")
  payload     Json
  claimedAt   DateTime?       @map("claimed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  actions     EngineAction[]

  @@index([id, kind])
  @@map("engine_events")
}

model EngineAction {
  id             Int          @id @default(autoincrement())
  eventId        Int?         @map("event_id")
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(120)
  actionType     String       @map("action_type") @db.VarChar(64)
  payload        Json
  result         Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  event          EngineEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@map("engine_actions")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  accountId Int?     @map("account_id")
  action    String   @db.VarChar(120)
  target    String?  @db.VarChar(120)
  payload   Json?
  ip        String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("audit_logs")
}
